# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key for AI Budget Pipeline (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-change-me

# ── Backend CORS (comma-separated origins) ────────────────────────────────────
# Local dev:
ALLOW_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://0.0.0.0,http://0.0.0.0:80
# Railway: set to your frontend Railway URL, e.g.:
# ALLOW_ORIGINS=https://your-frontend.up.railway.app

# ── Cookie security ──────────────────────────────────────────────────────────
# Defaults to True (HTTPS/production). Set False for local dev without HTTPS.
# COOKIE_SECURE=false

# ── Frontend build arg (set in Railway frontend service) ─────────────────────
# VITE_API_URL=https://your-backend.up.railway.app
