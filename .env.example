# Groq API key for AI Budget Pipeline
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: custom DB path (default: ai_implementation/data/budget_ai.db)
# DB_PATH=ai_implementation/data/budget_ai.db

# Optional: LLM model name (default: llama-3.3-70b-versatile)
# MODEL_NAME=llama-3.3-70b-versatile

# Backend CORS origins (specific origins required for auth cookies)
ALLOW_ORIGINS=http://localhost:80,http://localhost:5173,http://0.0.0.0,http://0.0.0.0:80

# JWT Authentication (REQUIRED: change in production, generate with: openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-change-me
