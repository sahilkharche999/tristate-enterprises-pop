JWT_SECRET_KEY=replace-with-rotated-secret
ENABLE_DOCS=false
GEMINI_MODEL=gemini-3.5-flash

# Production on GCP VM: Vertex/ADC auth via VM service account
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=budgeting-01
GOOGLE_CLOUD_LOCATION=global

ALLOW_ORIGINS=https://your-domain.example
COOKIE_SECURE=true
BUDGET_STORAGE_ROOT=/app/data/budget-storage
BACKEND_PUBLISH_HOST=127.0.0.1
BACKEND_PUBLISH_PORT=8000
FRONTEND_PUBLISH_HOST=127.0.0.1
FRONTEND_PUBLISH_PORT=8080

# Frontend build-time API origin
VITE_API_URL=https://your-domain.example
